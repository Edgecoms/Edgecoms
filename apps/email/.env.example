# Edge Mail (apps/email). Copy to .env for local dev.

# Shared with the partner platform: same database, same Better Auth secret,
# so the same admin accounts sign in here.
DATABASE_URL=postgresql://postgres:password@localhost:5435/edgecoms
BETTER_AUTH_SECRET=
# This app's own origin, NOT the partner platform's.
BETTER_AUTH_URL=http://localhost:3006
CORS_ORIGIN=http://localhost:3006
EDGE_MAIL_URL=http://localhost:3006

# Resend. The full-access key lives ONLY in this app's deployment.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Test mode is ON unless this is exactly "off". While on, every message goes
# to EDGE_MAIL_TEST_RECIPIENT, and nothing is sent if that is unset.
EDGE_MAIL_TEST_MODE=
EDGE_MAIL_TEST_RECIPIENT=

# Signs preference-page links. At least 32 characters.
EDGE_MAIL_PREFERENCES_SECRET=

# One HMAC secret per Edge app, at least 32 characters. An app with no
# secret is refused (401).
EDGE_MAIL_SECRET_EDGE_CART=
EDGE_MAIL_SECRET_EDGE_BUNDLES=
EDGE_MAIL_SECRET_EDGE_SUBSCRIPTIONS=
EDGE_MAIL_SECRET_EDGE_TIMER=
EDGE_MAIL_SECRET_EDGE_REVIEWS=
EDGE_MAIL_SECRET_EDGE_CURRENCY=
