# The course site needs exactly one variable, and it is not optional in any
# deploy that shows the signup form: without it every submission is refused and
# the visitor is told to email us instead. That is deliberate — see
# `src/app/actions.ts`. A form that silently drops signups is worse than one
# that admits it is broken.
DATABASE_URL="postgresql://user:password@localhost:5435/edgecoms"

# The public origin this site is served from. Sets the canonical URL and the
# OG/Twitter card URLs. MUST be the real domain in production — a canonical
# pointing at the wrong host tells Google the real page is a copy.
NEXT_PUBLIC_SITE_URL="https://course.edgecoms.com"
