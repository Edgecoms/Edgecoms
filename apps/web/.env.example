# ── Site ───────────────────────────────────────────────────────────────────
# Canonical public origin, no trailing slash. Drives every absolute URL the
# site emits: canonicals, OG tags, JSON-LD, the sitemap, and the blog's
# "Read this on your assistant" prompts. Defaults to https://edgecoms.app.
# Set it on preview deploys so their canonicals do not point at production.
# NOTE: this is a NEXT_PUBLIC_ var, so its value is inlined into the client
# bundle at BUILD time -- changing it requires a rebuild, not just a restart.
NEXT_PUBLIC_SITE_URL="https://edgecoms.app"

# ── Database ───────────────────────────────────────────────────────────────
# Postgres connection string. Local Docker default shown; on Railway use the
# private networking URL of the Postgres service.
DATABASE_URL="postgresql://postgres:password@localhost:5432/edgecoms"

# ── Better Auth ────────────────────────────────────────────────────────────
# 32+ char secret. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public base URL of the web app (no trailing slash).
BETTER_AUTH_URL="http://localhost:3001"
# Allowed origin for auth/tRPC requests.
CORS_ORIGIN="http://localhost:3001"

# ── Admin bootstrap (used by `bun run db:create-admin`) ────────────────────
ADMIN_EMAIL="admin@edgecoms.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Edge Admin"

# ── Shopify Partner API (billing sync) ─────────────────────────────────────
# Org-level credentials used by the billing-sync worker and the admin
# "Run sync now". Create the token at:
#   Partner Dashboard → Settings → Partner API clients
# The org id is the number in your partners.shopify.com/<org-id>/ dashboard URL.
# Optional everywhere else; required for the sync to do anything.
PARTNER_API_ORGANIZATION_ID=""
PARTNER_API_ACCESS_TOKEN=""
# Partner API version (use a current stable version from the dashboard).
PARTNER_API_VERSION="2026-04"

# Per-app GID overrides. The seed ships PLACEHOLDER GIDs for the 6 Edge apps;
# override each with its real Partner Dashboard GID using PARTNER_API_GID_<SLUG>
# (slug uppercased, hyphens → underscores), then re-run `bun run db:seed`:
# PARTNER_API_GID_EDGE_BUNDLES="gid://partners/App/123456"
# PARTNER_API_GID_EDGE_TIMER="gid://partners/App/123457"
# PARTNER_API_GID_EDGE_REVIEWS="gid://partners/App/123458"
# PARTNER_API_GID_EDGE_CART="gid://partners/App/123459"
# PARTNER_API_GID_EDGE_CURRENCY="gid://partners/App/123460"
# PARTNER_API_GID_EDGE_SUBSCRIPTIONS="gid://partners/App/123461"

# ── Meta Pixel (Facebook/Instagram ads) ────────────────────────────────────
# Dataset ("pixel") id from Events Manager. Digits only -- the env schema
# rejects anything else, so a pasted URL fails the build instead of sending
# events into the void.
#
# LEAVE THIS UNSET LOCALLY AND ON PREVIEW DEPLOYS. The pixel does not load
# without it, which is the point: clicking around a branch must not land in
# production ad data. Set it in the production environment only.
#
# NEXT_PUBLIC_, so it is inlined at BUILD time -- changing it needs a rebuild,
# not just a restart.
NEXT_PUBLIC_META_PIXEL_ID=""

# ── Meta Conversions API (server-side events) ──────────────────────────────
# The server-side half of the pixel. The browser and this server report the
# same event under the same event_id, so Meta counts it once -- but when a
# browser blocks the pixel (iOS, Safari ITP, ad blockers) the server copy is
# the only one that arrives. Expect it to recover roughly 20-40% of events.
#
# Create at: Events Manager -> your dataset -> Settings -> Conversions API ->
# "Generate access token". Treat it like a password; it is not NEXT_PUBLIC_ and
# must never reach the browser.
#
# Unset is a SOFT failure by design: the browser pixel simply runs alone. This
# is analytics, not the money system -- unlike EDGE_PARTNERS_SECRET above, it
# must not 503 a marketing page.
META_CAPI_ACCESS_TOKEN=""

# Graph API version. Meta supports each for about two years; v26.0 was current
# in September 2026. Pinned so a Meta release never changes the payload shape
# underneath us. Check https://developers.facebook.com/docs/graph-api/changelog
META_GRAPH_API_VERSION="v26.0"

# Set this temporarily to send events to Events Manager -> Test Events instead
# of the live dataset, then UNSET it. Find the code in the Test Events tab.
# Verifying the wiring should never cost real data.
META_CAPI_TEST_EVENT_CODE=""
